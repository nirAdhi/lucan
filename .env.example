# Public site origin, used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://ldic.ie

# GA4 measurement ID (PRD s40). Leave empty to disable analytics entirely.
NEXT_PUBLIC_GA4_ID=

# Google Search Console HTML verification token (PRD s19)
NEXT_PUBLIC_GSC_VERIFICATION=

# Where booking/enquiry submissions are delivered until Phase 3 (PRD s79) exists.
# If neither is set the booking API returns 503 and the UI tells the patient to phone
# the practice - it never silently swallows an enquiry.
BOOKING_NOTIFY_WEBHOOK=
BOOKING_LOG_FILE=.data/booking-requests.jsonl

# Google Places API key for the live review-rating badge and aggregateRating schema (see
# lib/googleRating.ts). Leave empty to show no rating at all - never a guessed number.
# Also set content/site.ts's `googlePlaceId`. Create a key at
# https://console.cloud.google.com/google/maps-apis/credentials (Places API enabled).
GOOGLE_PLACES_API_KEY=

# --- Admin CMS (Phase 2: /admin/dentists, /admin/pricing, /admin/case-studies) ---

# Required when running via `docker compose up` - docker-compose.yml builds the full
# DATABASE_URL from this plus the `db` service. Pick any password; it's created fresh in
# the `db` container's own volume, it doesn't need to match anything else.
POSTGRES_PASSWORD=

# Only needed if you run `npx prisma` commands directly on your own machine (outside
# Docker) against a Postgres instance you're running yourself - docker-compose.yml sets
# this itself for the `web` and `migrate` services.
DATABASE_URL=

# Signs the admin login session cookie. Generate one with `openssl rand -base64 32`.
AUTH_SECRET=

# The one admin login - a single username/password, no user table (see src/auth.ts).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
