// Prisma schema for the Phase 2 admin CMS (dentists, pricing, case studies).
// content/team.ts, content/pricing.ts and content/caseStudies.ts read through this -
// see those files for the accessor functions every page actually imports.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Mirrors TeamMember in src/content/team.ts field-for-field, plus photoUrl.
model Dentist {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  role           String
  qualifications String
  summary        String
  bio            String[]
  specialities   String[]
  /// Short chips for the team card, e.g. "Implants", "Oral surgery". Kept separate from
  /// `specialities`, which are full phrases written for the profile page and are far too
  /// long to sit in a pill.
  tags           String[]
  /// Treatment slugs this clinician leads on (content/treatments.ts), for "Your dentist".
  treatments     String[]
  photoUrl       String?
  registration   String?
  languages      String[]
  seoTitle       String
  seoDescription String
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("dentists")
}

/// Mirrors PriceItem/PriceGroup in src/content/pricing.ts, flattened with a group tag.
model PriceItem {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  price      String
  note       String?
  groupSlug  String
  groupTitle String
  groupOrder Int      @default(0)
  itemOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("price_items")
}

/// Patient testimonials - what someone says about their experience after treatment.
/// Managed at /admin/testimonials.
///
/// consentConfirmed gates public rendering and consentRecordedAt records WHEN the patient
/// agreed, because "we have consent" with no date is not much of a record if it is ever
/// questioned. Publishing a patient's words without documented consent is the specific
/// thing content/stories.ts was written to avoid, so the same rule applies here.
model Testimonial {
  id               String    @id @default(cuid())
  /// First name or initials only, as consented - not a full name.
  author           String
  /// Optional area, e.g. "Lucan" - adds context without identifying anyone.
  area             String?
  quote            String
  /// Treatment slug from content/treatments.ts, when the testimonial is about one.
  treatmentSlug    String?
  treatmentLabel   String?
  /// 1-5, optional. Only ever what the patient actually gave.
  rating           Int?
  consentConfirmed Boolean   @default(false)
  consentRecordedAt DateTime?
  order            Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("testimonials")
}

/// Before/after gallery (Kilmainham-style). consentConfirmed gates public rendering -
/// see content/caseStudies.ts - the same "never publish what isn't verified" rule this
/// codebase already applies to patient-stories and reviews.
model CaseStudy {
  id               String   @id @default(cuid())
  treatmentSlug    String
  treatmentLabel   String
  beforePhotoUrl   String
  afterPhotoUrl    String
  caption          String
  consentConfirmed Boolean  @default(false)
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("case_studies")
}
